SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Velouraz High Jewellery" <no-reply@domainname.in>

# Admin Email
