VITE_CLOUDINARY_CLOUD_NAME=dy1g9f3bj
VITE_CLOUDINARY_UPLOAD_PRESET=velouraz_preset

# Server-only variables for Cloudinary delete
CLOUDINARY_CLOUD_NAME=dy1g9f3bj
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
